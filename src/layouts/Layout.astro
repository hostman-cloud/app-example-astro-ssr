---
interface Props {
	title: string;
}

const { title } = Astro.props;
const { pathname } = Astro.url;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<div class="layout">
			<header class="header">
				<nav class="nav">
					<a href="/" class="logo">Astro SSR</a>
					<a href="/about" class:list={{ active: pathname === '/about' }}>About</a>
				</nav>
			</header>
			<main class="main">
				<slot />
			</main>
		</div>
	</body>
</html>

<style is:global>
	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		font-family:
			system-ui,
			-apple-system,
			Segoe UI,
			Roboto,
			sans-serif;
	}
</style>

<style>
	.layout {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	.header {
		border-bottom: 1px solid #e5e7eb;
		padding: 1rem 1.5rem;
	}

	.nav {
		max-width: 48rem;
		margin: 0 auto;
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}

	.nav a {
		color: #374151;
		text-decoration: none;
	}

	.nav a:hover {
		color: #111827;
	}

	.nav a.active {
		color: #2563eb;
		font-weight: 600;
	}

	.logo {
		font-weight: 700;
		margin-right: auto;
	}

	.main {
		flex: 1;
		max-width: 48rem;
		margin: 0 auto;
		padding: 2rem 1.5rem;
		width: 100%;
	}
</style>
